{
  "name": "qato",
  "displayName": "QA Testing Orchestrator",
  "description": "",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.85.0" 
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onCommand:qato.runHardcodedTest",
    "onCommand:qato.showPanel"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "qato.runHardcodedTest",
        "title": "QATO: Run Hardcoded Test"
      },
      {
        "command": "qato.showPanel",
        "title": "QATO: Show Panel"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src --ext ts",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/vscode": "^1.85.0",
    "@types/mocha": "^10.0.6",
    "@types/node": "20.x",
    "eslint": "^8.57.0",
    "typescript": "^5.3.3",
    "@vscode/test-cli": "^0.0.6",
    "@vscode/test-electron": "^2.3.9"
  }
}